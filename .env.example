# GitHub API Token (classic PAT)
# Create at: GitHub > Settings > Developer settings > Personal access tokens > Tokens (classic)
# Required scopes: public_repo, read:user
GITHUB_TOKEN=ghp_your_token_here

# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_api_key_here

# Optional: GPT-4 model used for classification
OPENAI_CLASSIFICATION_MODEL=gpt-4.1-mini

# Optional: extraction target size
TARGET_REPOSITORIES=1000
